class_name Player
extends CharacterBody2D
## The archaeology student. Every number lives in data/player.json
## (Data.player), reloadable with F3 and editable with F1.
##
## Controls (project.godot [input], generated by tools/gen_project_godot.py):
## Default controls (project.godot [input], generated by
## tools/gen_project_godot.py; every button below is remappable in
## Options → Controls, see game/autoload/controls.gd):
##   left stick / WASD   move — stick magnitude picks walk vs run
##   A / Space           jump (variable height, jump_height_tiles)
##   B / J               attack with the equipped weapon (whip follows aim)
##   X, Y / K, L         item slots
##   RT / S / Down       crouch + crawl (its own button, never stick-down)
##   RB / Shift          dash
##   LT (hold) / RMB     free-aim. Setting aim_swap_sticks (default on):
##                       left stick aims, right stick moves. Off (claw
##                       grip): left stick keeps moving, right stick aims.
##   LB / E              interact
##   Ctrl                walk (keyboard only; sticks use magnitude)

enum State { NORMAL, CROUCH, DASH, ATTACK, HURT, DEAD, GRAPPLE }

const LAYER_PLAYER := 1 << 1
const LAYER_WORLD := 1 << 0
## A drop-through (down + jump on a one-way ledge) moves the body this far
## down. It must beat the one-way tiles' 4 px collision margin
## (tools/gen_kind_tileset.gd), or the engine pushes it straight back up
## (it was 2 px, and dropping through never worked).
const DROP_THROUGH_NUDGE := 5.0
const LAYER_PUSHABLE := 1 << 8
const LAYER_PLAYER_HURTBOX := 1 << 3
const LAYER_PLAYER_HITBOX := 1 << 5
const MASK_PLAYER_HITBOX := (1 << 4) | (1 << 9) | (1 << 12)   # enemy_hurtbox | switch | breakable
const LAYER_INTERACT := 1 << 7
const LAYER_GRAPPLE := 1 << 10
## Where slingshot stones and the grappling hook leave from (feet-relative).
const SHOT_ORIGIN := Vector2(0, -22)
## Where melee swings are centred (feet-relative).
const SWING_ORIGIN := Vector2(0, -20)

var state: int = State.NORMAL
var facing := 1
var aiming := false
var aim_dir := Vector2.RIGHT
var in_water := false

var sprite: AnimatedSprite2D
var shape: CollisionShape2D
var hurtbox: Hurtbox
var hitbox: Hitbox
var hitbox_shape: CollisionShape2D
var light: PointLight2D
var camera: Camera2D
var aim_line: Line2D
var interact_sensor: Area2D
var grapple_line: Line2D
var reticle: AimReticle

## Which aimable thing the reticle previews: the last one used
## ("slingshot", "grapple", "weapon"), or "" — see _reticle_kind().
var _reticle_use := ""
var _coyote := 0.0
var _jump_buffer := 0.0
var _was_on_floor := false
var _dash_time := 0.0
var _dash_cooldown := 0.0
var _air_dash_used := false
var _attack_phase := 0  # 0 startup, 1 active, 2 recovery
var _attack_time := 0.0
var _attack_dir := Vector2.RIGHT
var _hurt_time := 0.0
var _iframes := 0.0
var _grapple_target: Node2D = null
var _grapple_cooldown := 0.0
var _item_cooldown := 0.0
var _step_timer := 0.0
var _land_time := 0.0
var _exit_pending: RoomExit = null
var _pushing := false
## Seconds the push clip is held after the last frame of block contact, so
## the per-frame contact jitter against a moving block doesn't flicker it.
var _push_hold := 0.0
var _stand_height := 42.0
var _crouch_height := 26.0
var _width := 16.0
## Top of the one-way ledge stood on last frame (Crush); NAN when none or
## when dropping through on purpose.
var _crush_ledge := NAN
## True on the frame the body's water sample point leaves the water.
var _just_surfaced := false


func body_width() -> float:
	return _width


func body_height() -> float:
	return _stand_height


## The collider as a world-space rect (current height: crouching is shorter).
func body_rect() -> Rect2:
	var h := maxf((shape.shape as CapsuleShape2D).height, _width)
	return Rect2(global_position + Vector2(-_width / 2.0, -h), Vector2(_width, h))


func _ready() -> void:
	add_to_group("player")
	collision_layer = LAYER_PLAYER
	collision_mask = LAYER_WORLD | LAYER_PUSHABLE
	floor_snap_length = 6.0
	floor_max_angle = deg_to_rad(50)
	safe_margin = 0.5
	_build_children()
	_apply_data()
	Data.reloaded.connect(_apply_data)
	GameState.slots_changed.connect(_on_slots_changed)
	_on_slots_changed()


func _build_children() -> void:
	shape = CollisionShape2D.new()
	shape.name = "Shape"
	shape.shape = CapsuleShape2D.new()
	add_child(shape)

	sprite = AnimatedSprite2D.new()
	sprite.name = "Sprite"
	add_child(sprite)
	SpriteDb.apply(sprite, "players", String(Data.player.get("sprite", "knight")),
			float(Data.player.get("sprite_fit_tiles", 1.5)))

	hurtbox = Hurtbox.new()
	hurtbox.name = "Hurtbox"
	hurtbox.collision_layer = LAYER_PLAYER_HURTBOX
	hurtbox.collision_mask = 0
	var hs := CollisionShape2D.new()
	hs.shape = CapsuleShape2D.new()
	hurtbox.add_child(hs)
	add_child(hurtbox)

	hitbox = Hitbox.new()
	hitbox.name = "Hitbox"
	hitbox.collision_layer = LAYER_PLAYER_HITBOX
	hitbox.collision_mask = MASK_PLAYER_HITBOX
	hitbox_shape = CollisionShape2D.new()
	hitbox_shape.shape = RectangleShape2D.new()
	hitbox.add_child(hitbox_shape)
	hitbox.source_node = self
	hitbox.hit_landed.connect(_on_hit_landed)
	add_child(hitbox)

	interact_sensor = Area2D.new()
	interact_sensor.name = "InteractSensor"
	interact_sensor.collision_layer = 0
	interact_sensor.collision_mask = LAYER_INTERACT
	var isr := CollisionShape2D.new()
	var circle := CircleShape2D.new()
	circle.radius = 28.0
	isr.shape = circle
	isr.position = Vector2(0, -20)
	interact_sensor.add_child(isr)
	add_child(interact_sensor)

	light = PointLight2D.new()
	light.name = "Light"
	light.texture = _make_light_texture()
	light.position = Vector2(0, -22)
	light.shadow_enabled = false
	add_child(light)

	aim_line = Line2D.new()
	aim_line.name = "AimLine"
	aim_line.width = 2.0
	aim_line.default_color = Color(1, 1, 0.8, 0.7)
	aim_line.visible = false
	aim_line.z_index = 5
	add_child(aim_line)

	reticle = AimReticle.new()
	reticle.name = "AimReticle"
	add_child(reticle)

	grapple_line = Line2D.new()
	grapple_line.name = "GrappleLine"
	grapple_line.width = 2.0
	grapple_line.default_color = Color(0.8, 0.8, 0.85)
	grapple_line.visible = false
	grapple_line.top_level = true
	grapple_line.z_index = 4
	add_child(grapple_line)

	camera = Camera2D.new()
	camera.name = "Camera"
	camera.position_smoothing_enabled = true
	camera.position_smoothing_speed = 8.0
	camera.position = Vector2(0, -24)
	add_child(camera)


func _apply_data() -> void:
	var p := Data.player
	var col: Dictionary = Data.req(p, "collider", "player.json")
	_width = Data.num(col, "width", "player.collider")
	_stand_height = Data.num(col, "height", "player.collider")
	_crouch_height = Data.num(col, "crouch_height", "player.collider")
	_set_body_height(_crouch_height if state == State.CROUCH else _stand_height)
	light.energy = Data.num(p, "light_energy", "player.json")
	_update_light_radius()


func _set_body_height(h: float) -> void:
	var cap: CapsuleShape2D = shape.shape
	cap.radius = _width / 2.0
	cap.height = maxf(h, _width)
	shape.position = Vector2(0, -h / 2.0)
	var hcap: CapsuleShape2D = hurtbox.get_child(0).shape
	hcap.radius = _width / 2.0 - 1.0
	hcap.height = maxf(h - 2.0, _width)
	hurtbox.get_child(0).position = Vector2(0, -h / 2.0)


func _make_light_texture() -> GradientTexture2D:
	var g := Gradient.new()
	g.set_color(0, Color(1, 1, 1, 1))
	g.set_color(1, Color(1, 1, 1, 0))
	g.add_point(0.35, Color(1, 1, 1, 0.75))
	var t := GradientTexture2D.new()
	t.gradient = g
	t.fill = GradientTexture2D.FILL_RADIAL
	t.fill_from = Vector2(0.5, 0.5)
	t.fill_to = Vector2(0.5, 1.0)
	t.width = 256
	t.height = 256
	return t


func _update_light_radius() -> void:
	var r := Data.num(Data.player, "lantern_radius" if GameState.lantern_on else "light_radius", "player.json")
	light.texture_scale = r / 128.0


func _on_slots_changed() -> void:
	_update_light_radius()


# --- input helpers ----------------------------------------------------------------------

func _move_input() -> Vector2:
	if aiming and _aim_from_pad() and _swap_sticks():
		return Input.get_vector("rs_left", "rs_right", "rs_up", "rs_down")
	var v := Input.get_vector("move_left", "move_right", "move_up", "move_down")
	if Input.is_action_pressed("walk"):
		v = v.limit_length(0.45)
	return v


## Options → "Aiming swaps sticks". On: the left stick aims and the right
## stick moves while aim is held (one-stick play). Off: the left stick
## keeps moving and the right stick aims (claw grip).
func _swap_sticks() -> bool:
	return bool(SaveManager.settings.get("aim_swap_sticks", true))


## True while the aim action is held by a joypad control (whatever it is
## bound to) rather than the mouse — decides which device aims.
func _aim_from_pad() -> bool:
	return Input.is_action_pressed("aim") and Controls.pad_pressed("aim")


## Tests (and a future scripted sequence) can force the aim direction
## while the aim action is held; zero = read the stick / mouse.
var forced_aim := Vector2.ZERO


func _update_aim() -> void:
	var was := aiming
	aiming = Input.is_action_pressed("aim")
	if not aiming:
		aim_line.visible = false
		return
	if not was:
		aim_dir = Vector2(facing, 0)   # until a stick or the mouse says otherwise
	if forced_aim != Vector2.ZERO:
		aim_dir = forced_aim.normalized()
	elif _aim_from_pad():
		var v := Input.get_vector("move_left", "move_right", "move_up", "move_down") if _swap_sticks() \
				else Input.get_vector("rs_left", "rs_right", "rs_up", "rs_down")
		if v.length() > 0.3:
			aim_dir = v.normalized()
	else:
		var to_mouse := get_global_mouse_position() - (global_position + Vector2(0, -20))
		if to_mouse.length() > 4.0:
			aim_dir = to_mouse.normalized()
	if absf(aim_dir.x) > 0.2:
		facing = 1 if aim_dir.x > 0 else -1
	aim_line.visible = true
	var len := Data.num(Data.player, "aim_indicator_length", "player.json")
	aim_line.points = PackedVector2Array([SWING_ORIGIN + aim_dir * 14.0, SWING_ORIGIN + aim_dir * len])


## Direction an aimable action goes: free-aim when held, else facing.
func action_dir() -> Vector2:
	return aim_dir if aiming else Vector2(facing, 0)


# --- aim reticle --------------------------------------------------------------------------
# While aiming, the reticle sits at the end of the aimed item's reach, or
# on the first thing it would hit along the aim line; red when the hook
# would catch it. Grapple and melee traces run the real attack's query;
# the slingshot's ignores gravity (Eir: show the aim, not the landing).

## Run after the body has moved this frame, so the trace starts where a
## shot fired next frame would.
func _update_reticle() -> void:
	var kind := _reticle_kind() if aiming else ""
	if kind == "":
		reticle.visible = false
		return
	var t: Dictionary
	match kind:
		"slingshot":
			t = _trace_slingshot(aim_dir)
		"grapple":
			t = _trace_grapple(aim_dir)
		_:
			t = _trace_swing(aim_dir)
	reticle.place(t.pos, t.hit, t.get("latch", false))


## The aimable things equipped, in fallback order (X, Y, weapon); the last
## one used wins while it's still equipped.
func _reticle_kind() -> String:
	var kinds: Array[String] = []
	for id: String in [GameState.slot_x, GameState.slot_y]:
		var use := String(GameState.item_def(id).get("use", "")) if id != "" else ""
		if use == "slingshot" or use == "grapple":
			kinds.append(use)
	if bool(_weapon_def().get("aimable", false)):
		kinds.append("weapon")
	if kinds.has(_reticle_use):
		return _reticle_use
	return kinds[0] if not kinds.is_empty() else ""


## Where the player is aiming, not where the stone lands: a straight line
## (no gravity, so a real stone drops below it) out to speed × lifetime,
## stopped by anything that would stop or take a stone.
func _trace_slingshot(dir: Vector2) -> Dictionary:
	var cfg: Dictionary = Data.req(Data.objects, "slingshot", "objects.json")
	var from := global_position + SHOT_ORIGIN + dir * 12.0
	var reach := Data.num(cfg, "speed", "objects.slingshot") * Data.num(cfg, "lifetime", "objects.slingshot")
	var to := from + dir * reach
	var hit := Projectile.sweep(get_world_2d().direct_space_state, from, to, Projectile.SLINGSHOT_RADIUS,
			Projectile.SLINGSHOT_MASK | Projectile.SLINGSHOT_SOLIDS, true, room)
	if hit.is_empty():
		return {"pos": to, "hit": false}
	return {"pos": hit.position, "hit": true}


func _trace_grapple(dir: Vector2) -> Dictionary:
	var g := _grapple_ray(dir)
	if g.hit.is_empty():
		return {"pos": g.to, "hit": false}
	var col: Object = g.hit.collider
	var mode := String(col.grapple_mode(self)) if col != null and col.has_method("grapple_mode") else "none"
	return {"pos": g.hit.position, "hit": true, "latch": mode == "anchor" or mode == "pull"}


## An aimable melee weapon: the far edge of its hitbox, or the first thing
## along the swing line it would strike. The hitbox ignores walls (it's an
## Area on the hit layers only), so the trace does too.
func _trace_swing(dir: Vector2) -> Dictionary:
	var w := _weapon_def()
	var box: Array = Data.req(w, "hitbox", "weapons.json")
	var from := global_position + SWING_ORIGIN
	var to := from + dir * (Data.num(w, "reach", "weapons.json") + float(box[0]) / 2.0)
	var q := PhysicsRayQueryParameters2D.create(from, to, MASK_PLAYER_HITBOX)
	q.collide_with_areas = true
	var hit := get_world_2d().direct_space_state.intersect_ray(q)
	if hit.is_empty():
		return {"pos": to, "hit": false}
	return {"pos": hit.position, "hit": true}


# --- physics ----------------------------------------------------------------------------

func _physics_process(delta: float) -> void:
	if state == State.DEAD:
		velocity.x = move_toward(velocity.x, 0.0, 600 * delta)
		velocity.y += _gravity() * delta
		move_and_slide()
		return
	var p := Data.player
	_tick_timers(delta)
	_update_aim()
	_sample_tile_kinds()
	var move := _move_input()
	var on_floor := is_on_floor()

	match state:
		State.NORMAL, State.CROUCH:
			_tick_normal(delta, p, move, on_floor)
		State.DASH:
			_tick_dash(delta, p)
		State.ATTACK:
			_tick_attack(delta, p, move, on_floor)
		State.HURT:
			_tick_hurt(delta, p)
		State.GRAPPLE:
			_tick_grapple(delta, p)

	if state != State.GRAPPLE:
		move_and_slide()
	_check_crush()
	_handle_pushes(move, delta)
	_update_animation(move, on_floor)
	_landing_check(on_floor)
	_was_on_floor = is_on_floor()
	_update_reticle()
	if _exit_pending != null:
		var e := _exit_pending
		_exit_pending = null
		var world := get_tree().get_first_node_in_group("world")
		if world != null:
			world.transition(e)


func _tick_timers(delta: float) -> void:
	_coyote = maxf(_coyote - delta, 0.0)
	_jump_buffer = maxf(_jump_buffer - delta, 0.0)
	_dash_cooldown = maxf(_dash_cooldown - delta, 0.0)
	_iframes = maxf(_iframes - delta, 0.0)
	_grapple_cooldown = maxf(_grapple_cooldown - delta, 0.0)
	_item_cooldown = maxf(_item_cooldown - delta, 0.0)
	_land_time = maxf(_land_time - delta, 0.0)
	_exit_lock = maxf(_exit_lock - delta, 0.0)
	if _iframes > 0.0:
		sprite.modulate.a = 0.4 if fmod(_iframes * 20.0, 2.0) < 1.0 else 1.0
	else:
		sprite.modulate.a = 1.0
	hurtbox.enabled = _iframes <= 0.0 and state != State.DEAD


func _gravity() -> float:
	var p := Data.player
	var g := Data.num(p, "gravity", "player.json")
	if in_water:
		return g * Data.num(p, "swim_gravity_mult", "player.json")
	if velocity.y > 0.0:
		return g * Data.num(p, "fall_gravity_mult", "player.json")
	return g


## Take-off speed for a full jump, derived from `jump_height_tiles` so the
## tunable is the thing a level designer thinks in. v = sqrt(2 g h), plus
## half a tick of gravity: the integrator adds gravity before moving, so
## without it a 4-tile jump tops out a hair under 4 tiles.
func jump_velocity() -> float:
	var p := Data.player
	var g := Data.num(p, "gravity", "player.json")
	var h := Data.num(p, "jump_height_tiles", "player.json") * Room.TILE
	var tick := 1.0 / float(Engine.physics_ticks_per_second)
	return -(sqrt(2.0 * g * h) + 0.5 * g * tick)


## Take-off speed for leaping out of water: lifts the feet
## `swim_exit_jump_tiles` above the surface. Called the frame the water
## sample point surfaces, so the surface is the bottom of the cell that
## point is now in, and the feet start that far below it. Same
## v = sqrt(2 g h) plus half a tick as jump_velocity().
func _water_exit_velocity() -> float:
	var p := Data.player
	var g := Data.num(p, "gravity", "player.json")
	var sample := room.to_local(global_position + Vector2(0, -_stand_height * 0.45))
	var surface := room.to_global(Vector2(0, (room.collision.local_to_map(sample).y + 1) * Room.TILE)).y
	var h := Data.num(p, "swim_exit_jump_tiles", "player.json") * Room.TILE + (global_position.y - surface)
	var tick := 1.0 / float(Engine.physics_ticks_per_second)
	return -(sqrt(2.0 * g * maxf(h, 0.0)) + 0.5 * g * tick)


func _apply_gravity(delta: float) -> void:
	velocity.y += _gravity() * delta
	var p := Data.player
	var term := Data.num(p, "swim_terminal" if in_water else "terminal_velocity", "player.json")
	velocity.y = minf(velocity.y, term)


func _tick_normal(delta: float, p: Dictionary, move: Vector2, on_floor: bool) -> void:
	if on_floor:
		_coyote = Data.num(p, "coyote_time", "player.json")
		_air_dash_used = false
	# --- crouch / crawl -----------------------------------------------
	# Crouch starts on the floor; once crouched it holds in the air too (a
	# crouch jump keeps the short collider) for as long as crouch is held.
	var want_crouch := Input.is_action_pressed("crouch") and not in_water \
			and (on_floor or state == State.CROUCH)
	if state == State.CROUCH:
		if not want_crouch and not _ceiling_blocked():
			state = State.NORMAL
			_set_body_height(_stand_height)
	elif want_crouch:
		state = State.CROUCH
		_set_body_height(_crouch_height)
		SpriteDb.play(sprite, "crouch", ["crouch_idle"])
	# --- horizontal ---------------------------------------------------------
	var mag := move.length()
	var walk_threshold := Data.num(p, "walk_threshold", "player.json")
	var speed := 0.0
	if state == State.CROUCH:
		speed = Data.num(p, "crouch_speed", "player.json")
	elif in_water:
		speed = Data.num(p, "swim_speed", "player.json")
	elif mag < walk_threshold:
		speed = Data.num(p, "walk_speed", "player.json")
	else:
		speed = Data.num(p, "run_speed", "player.json")
	speed *= _passive_speed_mult()
	if aiming:
		speed *= Data.num(p, "aim_move_mult", "player.json")
	var target := 0.0
	if absf(move.x) > 0.05:
		target = signf(move.x) * speed
		if not aiming:
			facing = 1 if move.x > 0 else -1
	var accel := Data.num(p, "accel" if on_floor else "air_accel", "player.json")
	if absf(target) < absf(velocity.x) or signf(target) != signf(velocity.x):
		accel = Data.num(p, "decel", "player.json") if on_floor else accel
	velocity.x = move_toward(velocity.x, target, accel * delta)
	# --- vertical -----------------------------------------------------------------
	if Input.is_action_just_pressed("jump"):
		_jump_buffer = Data.num(p, "jump_buffer", "player.json")
	if in_water:
		velocity.y += _gravity() * delta
		if Input.is_action_pressed("jump"):
			velocity.y = move_toward(velocity.y, Data.num(p, "swim_up_velocity", "player.json"), 1600 * delta)
		velocity.y = clampf(velocity.y, -Data.num(p, "swim_terminal", "player.json") * 1.5,
				Data.num(p, "swim_terminal", "player.json"))
		_jump_buffer = 0.0
	else:
		if _just_surfaced and velocity.y < 0.0 and Input.is_action_pressed("jump"):
			# Swimming up with jump held leaps out; swim speed alone never
			# lifts the feet clear of the surface.
			velocity.y = _water_exit_velocity()
			_jump_buffer = 0.0
			Sfx.play("jump", self)
			SpriteDb.play(sprite, "jump")
		if _jump_buffer > 0.0 and _coyote > 0.0:
			if _holding_down(move, p) and _standing_on_oneway():
				# Down + jump drops through a one-way ledge — the only way
				# down through one (design §7.6).
				_jump_buffer = 0.0
				_crush_ledge = NAN   # on purpose: not a squeeze
				position.y += DROP_THROUGH_NUDGE
				velocity.y = 40.0
				_coyote = 0.0
			else:
				# Crouched, this is a crouch jump: same height, short collider
				# kept (no ceiling check needed — it doesn't stand up).
				velocity.y = jump_velocity()
				_jump_buffer = 0.0
				_coyote = 0.0
				Sfx.play("jump", self)
				SpriteDb.play(sprite, "jump")
		elif velocity.y < 0.0 and Input.is_action_just_released("jump"):
			velocity.y *= Data.num(p, "jump_cut_mult", "player.json")
		# Gravity every frame, the jump frame included — jump_velocity()'s
		# derivation assumes exactly that.
		_apply_gravity(delta)
	# --- verbs ------------------------------------------------------------------------
	if Input.is_action_just_pressed("dash") and _dash_cooldown <= 0.0 and state == State.NORMAL \
			and (on_floor or not _air_dash_used) and not in_water:
		_start_dash(p)
		return
	if Input.is_action_just_pressed("attack") and state != State.CROUCH:
		_start_attack(p)
		return
	if Input.is_action_just_pressed("item_x"):
		use_slot(GameState.slot_x)
	elif Input.is_action_just_pressed("item_y"):
		use_slot(GameState.slot_y)
	if Input.is_action_just_pressed("interact"):
		_interact()


func _passive_speed_mult() -> float:
	var m := 1.0
	for id: String in GameState.inventory:
		var def := GameState.item_def(id)
		if def.get("kind", "") == "passive" and def.has("speed_mult"):
			m *= float(def.speed_mult)
	return m


func _ceiling_blocked() -> bool:
	# Would the standing capsule overlap something?
	var cap := CapsuleShape2D.new()
	cap.radius = _width / 2.0 - 1.0
	cap.height = _stand_height - 2.0
	var params := PhysicsShapeQueryParameters2D.new()
	params.shape = cap
	params.transform = Transform2D(0.0, global_position + Vector2(0, -_stand_height / 2.0))
	params.collision_mask = LAYER_WORLD | LAYER_PUSHABLE
	params.exclude = [get_rid()]
	return not get_world_2d().direct_space_state.intersect_shape(params, 1).is_empty()


## Down held for a drop-through: the move stick/keys pointing mostly down,
## at least player.drop_through_down (below the walk modifier's 0.45 cap,
## so walk + down still drops).
func _holding_down(move: Vector2, p: Dictionary) -> bool:
	return move.y >= Data.num(p, "drop_through_down", "player.json") and move.y >= absf(move.x)


func _standing_on_oneway() -> bool:
	var room := _room()
	if room == null:
		return false
	var feet := room.to_local(global_position + Vector2(0, 2.0))
	return room.kind_at(feet) == "oneway"


## Set by World on every room load (the player is a sibling of the room).
var room: Room = null
var _exit_lock := 0.0


func _room() -> Room:
	return room


func _sample_tile_kinds() -> void:
	var room := _room()
	if room == null:
		return
	var centre := room.to_local(global_position + Vector2(0, -_stand_height * 0.45))
	var feet := room.to_local(global_position + Vector2(0, -2.0))
	var k_centre := room.kind_at(centre)
	var k_feet := room.kind_at(feet)
	var was_water := in_water
	in_water = k_centre == "water"
	_just_surfaced = was_water and not in_water
	if in_water and not was_water:
		Sfx.play("splash", self)
	if k_feet == "hazard" and _iframes <= 0.0 and state != State.DEAD:
		var p := Data.player
		var kb: Array = Data.req(p, "hazard_knockback", "player.json")
		var dmg := Data.inum(p, "hazard_damage", "player.json")
		for id: String in GameState.inventory:
			if bool(GameState.item_def(id).get("hazard_protect", false)):
				dmg = maxi(dmg - 1, 0)
		on_hit({"damage": dmg, "knockback": Vector2(-facing * float(kb[0]), float(kb[1])),
				"source": null, "kind": "hazard", "tier": 0, "hitstop": 0.0})


# --- dash ----------------------------------------------------------------------------------

func _start_dash(p: Dictionary) -> void:
	state = State.DASH
	_dash_time = Data.num(p, "dash_time", "player.json")
	_dash_cooldown = Data.num(p, "dash_cooldown", "player.json")
	if not is_on_floor():
		_air_dash_used = true
	velocity = Vector2(facing * Data.num(p, "dash_speed", "player.json"), 0.0)
	if bool(Data.req(p, "dash_iframes", "player.json")):
		_iframes = maxf(_iframes, _dash_time)
	Sfx.play("dash", self)
	SpriteDb.play(sprite, "dash", ["run"])


func _tick_dash(delta: float, p: Dictionary) -> void:
	_dash_time -= delta
	velocity.x = facing * Data.num(p, "dash_speed", "player.json")
	velocity.y = 0.0
	if _dash_time <= 0.0 or is_on_wall():
		state = State.NORMAL
		velocity.x *= 0.5


# --- attack --------------------------------------------------------------------------------

func _weapon_def() -> Dictionary:
	if GameState.weapon == "":
		return {}
	var item := GameState.item_def(GameState.weapon)
	var wid := String(item.get("weapon", ""))
	if not Data.weapons.has(wid):
		push_error("weapons.json: unknown weapon '%s'" % wid)
		return {}
	return Data.weapons[wid]


func _start_attack(_p: Dictionary) -> void:
	var w := _weapon_def()
	if w.is_empty():
		return
	state = State.ATTACK
	_attack_phase = 0
	_attack_time = Data.num(w, "startup", "weapons.json")
	_attack_dir = action_dir() if bool(w.get("aimable", false)) else Vector2(facing, 0)
	if bool(w.get("aimable", false)):
		_reticle_use = "weapon"
	if absf(_attack_dir.x) > 0.2:
		facing = 1 if _attack_dir.x > 0 else -1
	var box: Array = Data.req(w, "hitbox", "weapons.json")
	var rect: RectangleShape2D = hitbox_shape.shape
	rect.size = Vector2(float(box[0]), float(box[1]))
	var reach := Data.num(w, "reach", "weapons.json")
	hitbox.position = Vector2(0, -20) + _attack_dir * reach
	hitbox.rotation = _attack_dir.angle() if bool(w.get("aimable", false)) else 0.0
	hitbox.damage = Data.inum(w, "damage", "weapons.json")
	var kb: Array = Data.req(w, "knockback", "weapons.json")
	hitbox.knockback = Vector2(float(kb[0]), float(kb[1]))
	hitbox.hitstop = float(w.get("hitstop", 0.05))
	hitbox.facing = facing
	hitbox.kind = "melee"
	Sfx.play(String(w.get("sfx", "swing")), self)
	var clip := String(w.get("clip", "attack"))
	if not is_on_floor():
		SpriteDb.play(sprite, "attack_air", [clip])
	else:
		sprite.stop()
		SpriteDb.play(sprite, clip)


func _tick_attack(delta: float, p: Dictionary, move: Vector2, on_floor: bool) -> void:
	var w := _weapon_def()
	_attack_time -= delta
	if on_floor:
		velocity.x = move_toward(velocity.x, 0.0, Data.num(p, "decel", "player.json") * delta)
	else:
		var accel := Data.num(p, "air_accel", "player.json") * 0.5
		velocity.x = move_toward(velocity.x, move.x * Data.num(p, "run_speed", "player.json"), accel * delta)
	_apply_gravity(delta)
	if _attack_time <= 0.0:
		_attack_phase += 1
		match _attack_phase:
			1:
				_attack_time = Data.num(w, "active", "weapons.json")
				hitbox.active = true
			2:
				_attack_time = Data.num(w, "recovery", "weapons.json")
				hitbox.active = false
			_:
				state = State.NORMAL
	if Input.is_action_just_pressed("jump"):
		_jump_buffer = Data.num(p, "jump_buffer", "player.json")


func _on_hit_landed(target: Node, info: Dictionary) -> void:
	Juice.hitstop(float(info.get("hitstop", 0.0)))
	# A Hitbox reports the overlapped Area (the Hurtbox); the enemy is its owner.
	var who: Node = target
	if target is Hurtbox:
		who = target.owner if target.owner != null else target.get_parent()
	if who != null and who.has_method("is_enemy"):
		Sfx.play("hit", self)


# --- hurt / death ----------------------------------------------------------------------------

func on_hit(info: Dictionary) -> void:
	if _iframes > 0.0 or state == State.DEAD:
		return
	var p := Data.player
	var dmg := int(info.get("damage", 1))
	GameState.damage(dmg)
	Juice.hitstop(0.08)
	Juice.shake(3.0, 0.2)
	Sfx.play("player_hurt", self)
	if GameState.hp <= 0:
		_die()
		return
	if state == State.CROUCH:
		_set_body_height(_stand_height)
	if state == State.GRAPPLE:
		_end_grapple()
	state = State.HURT
	_hurt_time = Data.num(p, "hurt_stun", "player.json")
	_iframes = Data.num(p, "iframes", "player.json")
	hitbox.active = false
	var kb: Vector2 = info.get("knockback", Vector2.ZERO)
	var origin: Vector2 = info.get("origin", global_position + Vector2(-facing, 0))
	var away := signf(global_position.x - origin.x)
	if away == 0.0:
		away = -facing
	var hk: Array = Data.req(p, "hurt_knockback", "player.json")
	velocity = Vector2(away * maxf(absf(kb.x), float(hk[0])), minf(kb.y, float(hk[1])))
	SpriteDb.play(sprite, "hurt")


func _tick_hurt(delta: float, p: Dictionary) -> void:
	_hurt_time -= delta
	_apply_gravity(delta)
	velocity.x = move_toward(velocity.x, 0.0, Data.num(p, "decel", "player.json") * 0.5 * delta)
	if _hurt_time <= 0.0:
		state = State.NORMAL


## Design §7.6: squeezed by a moving solid, the player is displaced and
## hurt, or (nowhere to go) hurt and voided out to the room's last entrance.
func _check_crush() -> void:
	if room == null:
		return
	var out := {}
	match Crush.resolve(self, room, out, _crush_ledge):
		Crush.DISPLACED:
			on_hit(Crush.hit_info(self, out.offset))
		Crush.TRAPPED:
			on_hit(Crush.hit_info(self, Vector2.ZERO))
			if GameState.hp > 0:
				var world := get_tree().get_first_node_in_group("world")
				if world != null:
					world.void_out()
	_crush_ledge = Crush.ledge_under(self, room, _crush_ledge)


func _die() -> void:
	state = State.DEAD
	hitbox.active = false
	aim_line.visible = false
	reticle.visible = false
	Sfx.play("player_death", self)
	SpriteDb.play(sprite, "death", ["hurt"])
	var world := get_tree().get_first_node_in_group("world")
	if world != null:
		world.on_player_died()


# --- items ------------------------------------------------------------------------------------

func use_slot(item_id: String) -> void:
	if item_id == "" or _item_cooldown > 0.0 or not GameState.has_item(item_id):
		return
	var def := GameState.item_def(item_id)
	match String(def.get("use", "")):
		"slingshot":
			_reticle_use = "slingshot"
			_fire_slingshot()
		"grapple":
			_reticle_use = "grapple"
			_fire_grapple()
		"lantern":
			toggle_lantern()
		"climbing_gear":
			var world := get_tree().get_first_node_in_group("world")
			if world != null:
				world.toast("Climbing gear: rope anchors are not built yet.")
		_:
			if bool(def.get("usable", false)):
				use_item_from_menu(item_id)


## The menu's Use verb (consumables, lantern) — also reachable in play.
func use_item_from_menu(item_id: String) -> bool:
	var def := GameState.item_def(item_id)
	if def.is_empty():
		return false
	match String(def.get("use", "")):
		"lantern":
			toggle_lantern()
			return true
	if def.has("heal"):
		if GameState.hp >= GameState.max_hp:
			return false
		GameState.heal(int(def.heal))
		GameState.remove_item(item_id, 1)
		Sfx.play("heal", self)
		SpriteDb.play(sprite, "use_item")
		return true
	return false


func toggle_lantern() -> void:
	GameState.lantern_on = not GameState.lantern_on
	_update_light_radius()
	Sfx.play("lantern_on" if GameState.lantern_on else "lantern_off", self)
	_item_cooldown = 0.2


func _fire_slingshot() -> void:
	var cfg: Dictionary = Data.req(Data.objects, "slingshot", "objects.json")
	var dir := action_dir()
	var shot := Projectile.new()
	shot.setup_slingshot(cfg, self, dir)
	# Into the tree first: before that, global_position is just position,
	# and the room sits at its world offset, so every room but one at
	# (0, 0) put the stone thousands of px away.
	(room if room != null else get_parent()).add_child(shot)
	shot.global_position = global_position + SHOT_ORIGIN + dir * 12.0
	Sfx.play("slingshot", self)
	_item_cooldown = 0.18
	if absf(dir.x) > 0.2:
		facing = 1 if dir.x > 0 else -1


func _fire_grapple() -> void:
	if _grapple_cooldown > 0.0 or state == State.GRAPPLE:
		return
	var cfg: Dictionary = Data.req(Data.objects, "grapple", "objects.json")
	var dir := action_dir()
	if absf(dir.x) > 0.2:
		facing = 1 if dir.x > 0 else -1
	var g := _grapple_ray(dir)
	var hit: Dictionary = g.hit
	Sfx.play("grapple_shot", self)
	_grapple_cooldown = Data.num(cfg, "cooldown", "objects.grapple")
	_item_cooldown = 0.15
	var end: Vector2 = g.to
	if not hit.is_empty():
		end = hit.position
		var col: Node = hit.collider
		if col != null and col.has_method("grapple_hit"):
			var mode: String = col.grapple_hit(self)
			if mode == "anchor":
				_grapple_target = col
				state = State.GRAPPLE
				velocity = Vector2.ZERO
				Sfx.play("grapple_latch", self)
			elif mode == "pull":
				Sfx.play("grapple_latch", self)
	_show_grapple_line(g.from, end, 0.12)


## The hook's raycast, shared by firing and the aim reticle:
## {from, to, hit} where hit is intersect_ray's result (empty on a miss).
func _grapple_ray(dir: Vector2) -> Dictionary:
	var cfg: Dictionary = Data.req(Data.objects, "grapple", "objects.json")
	var from := global_position + SHOT_ORIGIN
	var to := from + dir * Data.num(cfg, "range", "objects.grapple")
	var q := PhysicsRayQueryParameters2D.create(from, to, LAYER_WORLD | LAYER_PUSHABLE | LAYER_GRAPPLE)
	q.exclude = [get_rid()]
	q.collide_with_areas = true
	q.collide_with_bodies = true
	return {"from": from, "to": to, "hit": get_world_2d().direct_space_state.intersect_ray(q)}


func _show_grapple_line(from: Vector2, to: Vector2, seconds: float) -> void:
	grapple_line.points = PackedVector2Array([from, to])
	grapple_line.visible = true
	if seconds > 0.0:
		await get_tree().create_timer(seconds).timeout
		if state != State.GRAPPLE:
			grapple_line.visible = false


func _tick_grapple(_delta: float, _p: Dictionary) -> void:
	if _grapple_target == null or not is_instance_valid(_grapple_target):
		_end_grapple()
		return
	var cfg: Dictionary = Data.req(Data.objects, "grapple", "objects.json")
	var target := _grapple_target.global_position
	var centre := global_position + Vector2(0, -22)
	var to := target - centre
	grapple_line.points = PackedVector2Array([centre, target])
	grapple_line.visible = true
	var arrive := Data.num(cfg, "arrive_distance", "objects.grapple")
	if to.length() <= arrive or Input.is_action_just_pressed("jump"):
		_end_grapple()
		if Input.is_action_just_pressed("jump"):
			velocity.y = jump_velocity() * 0.8
		return
	var dir := to.normalized()
	velocity = dir * Data.num(cfg, "pull_speed", "objects.grapple")
	move_and_slide()
	# Blocked by something in the way (not the floor we're leaving).
	for i in get_slide_collision_count():
		var c := get_slide_collision(i)
		if c.get_normal().dot(dir) < -0.6 and to.length() > arrive * 2.0:
			_end_grapple()
			return


func _end_grapple() -> void:
	state = State.NORMAL
	_grapple_target = null
	grapple_line.visible = false
	velocity = velocity.limit_length(260.0)


# --- interaction, pushing, exits -------------------------------------------------------------

func _interact() -> void:
	var best: Node = null
	var best_d := INF
	for a in interact_sensor.get_overlapping_areas():
		if a.has_method("interact"):
			var d := a.global_position.distance_to(global_position)
			if d < best_d:
				best_d = d
				best = a
	if best != null:
		best.interact(self)


## Pushing is detected with a short test_move toward the stick, not from
## the slide collisions of the move that just happened: the block moves
## too, so contact is reported on some frames and not others, and that
## jitter used to flicker the push clip every frame. The clip is also held
## for PUSH_HOLD after the last contact.
const PUSH_PROBE := 2.0
const PUSH_HOLD := 0.1


func _handle_pushes(move: Vector2, delta: float) -> void:
	_pushing = false
	_push_hold = maxf(_push_hold - delta, 0.0)
	if not is_on_floor() or absf(move.x) < 0.3 or state == State.CROUCH:
		_push_hold = 0.0
		return
	var dir := signf(move.x)
	var hit := KinematicCollision2D.new()
	if test_move(global_transform, Vector2(dir * PUSH_PROBE, 0.0), hit):
		var col := hit.get_collider()
		if col != null and col.has_method("push") and absf(hit.get_normal().x) > 0.7:
			col.push(dir, delta)
			_pushing = true
			_push_hold = PUSH_HOLD


func is_pushing() -> bool:
	return _pushing or _push_hold > 0.0


## Exits poll this every physics frame while the player overlaps them
## (RoomExit._physics_process), so a request dropped by a lock or a
## transition in flight is simply made again next frame.
func request_exit(exit: RoomExit) -> void:
	if state == State.DEAD or _exit_lock > 0.0:
		return
	if not exit.is_open():
		return
	_exit_pending = exit


## World calls this on arrival: exits stay quiet for the fade-in. Arrival
## placement (World._clear_of_arrival_exit) keeps the body out of the
## matching exit's trigger, so this only needs to cover the fade.
func lock_exits(seconds: float) -> void:
	_exit_lock = seconds


# --- animation ---------------------------------------------------------------------------------

func _update_animation(move: Vector2, on_floor: bool) -> void:
	sprite.flip_h = facing < 0
	match state:
		State.ATTACK, State.HURT, State.DASH, State.DEAD:
			return
		State.GRAPPLE:
			SpriteDb.play(sprite, "jump", ["fall"])
			return
		State.CROUCH:
			if absf(velocity.x) > 5.0:
				SpriteDb.play(sprite, "crawl", ["crouch_idle"])
			elif sprite.animation != "crouch" or not sprite.is_playing():
				SpriteDb.play(sprite, "crouch_idle")
			return
	if in_water:
		SpriteDb.play(sprite, "swim", ["fall"])
		return
	if not on_floor:
		if velocity.y < -20.0:
			if sprite.animation != "jump":
				SpriteDb.play(sprite, "jump")
		else:
			SpriteDb.play(sprite, "fall")
		return
	if _land_time > 0.0 and absf(velocity.x) < 10.0:
		return
	if is_pushing():
		SpriteDb.play(sprite, "push", ["walk"])
	elif aiming and absf(velocity.x) < 5.0:
		SpriteDb.play(sprite, "aim", ["idle"])
	elif absf(velocity.x) > 5.0:
		var run_speed := Data.num(Data.player, "run_speed", "player.json")
		SpriteDb.play(sprite, "run" if absf(velocity.x) > run_speed * 0.6 else "walk", ["run"])
		_step_timer -= get_physics_process_delta_time()
		if _step_timer <= 0.0:
			_step_timer = 0.28 if sprite.animation == "run" else 0.42
			Sfx.play("footstep" if randi() % 2 == 0 else "footstep_2", self)
	else:
		SpriteDb.play(sprite, "idle")


func _landing_check(on_floor_before: bool) -> void:
	if not _was_on_floor and is_on_floor() and velocity.y >= 0.0 and state != State.DASH:
		Sfx.play("land", self)
		if state == State.NORMAL:
			_land_time = 0.12
			SpriteDb.play(sprite, "land", ["idle"])


## Place the player's feet at a world position, facing a direction.
func spawn_at(world_pos: Vector2, face: int = 1) -> void:
	global_position = world_pos
	_crush_ledge = NAN
	velocity = Vector2.ZERO
	facing = face
	state = State.NORMAL
	_set_body_height(_stand_height)
	camera.reset_smoothing()


func revive() -> void:
	state = State.NORMAL
	_iframes = 1.0
	sprite.modulate.a = 1.0
	hurtbox.enabled = true
	SpriteDb.play(sprite, "idle")
