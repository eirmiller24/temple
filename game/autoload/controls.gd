extends Node
## Button remapping. project.godot (generated by tools/gen_project_godot.py)
## holds the DEFAULT input map; this autoload captures it at boot and then
## owns the live InputMap: SaveManager.settings.bindings overrides any
## remappable action's pad and/or keyboard events, and the menu actions
## that mirror a gameplay button (B is "use" in the item list because B is
## attack, X/Y pick a slot because they are the item buttons, LB assigns
## because LB interacts…) are rebuilt from the mirrored action so the
## menus follow a remap for free. Godot's own ui_accept / ui_cancel follow
## menu_accept / menu_back the same way, so focused buttons agree with
## the rest of the UI.
##
## UI text never hard-codes a button name: glyph(action) / hint(pairs)
## return the live binding ("B", "LB", "Space", "RMB"), pad glyphs while a
## joypad is connected and keyboard ones otherwise.
##
## Bindings are stored per action as {"pad": [events], "key": [events]}
## where an event is one of
##   {"t": "btn",   "i": JoyButton}
##   {"t": "axis",  "a": JoyAxis, "v": ±1.0}        (triggers only)
##   {"t": "key",   "k": physical keycode}
##   {"t": "mouse", "i": MouseButton}
## A missing side keeps the default for that device.

signal bindings_changed

## Remappable actions, in the order the Controls panel shows them:
## [action, display name]. move_* and rs_* (sticks, d-pad, WASD/arrows)
## are not remappable yet.
const ACTIONS := [
	["jump", "Jump"],
	["attack", "Attack"],
	["item_x", "Item 1"],
	["item_y", "Item 2"],
	["interact", "Interact"],
	["dash", "Dash"],
	["crouch", "Crouch / crawl"],
	["aim", "Free aim (hold)"],
	["walk", "Walk (keyboard)"],
	["pause", "Pause / items"],
	["map", "Map"],
	["menu_accept", "Menu: accept"],
	["menu_back", "Menu: back"],
]

## Menu actions that are the same physical control as a gameplay action.
const MIRRORS := {
	"menu_use": "attack",
	"menu_slot_x": "item_x",
	"menu_slot_y": "item_y",
	"menu_drop": "item_y",
	"menu_assign": "interact",
	"menu_tab_prev": "interact",
	"menu_tab_next": "dash",
	"ui_accept": "menu_accept",
	"ui_cancel": "menu_back",
}

## Keyboard events a menu action always has, on top of its mirror.
## (physical keycodes; see KEY_* constants)
const FIXED_KEYS := {
	"menu_accept": [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE],
	"menu_back": [KEY_BACKSPACE],
	"menu_tab_prev": [KEY_Q],
	"menu_tab_next": [KEY_R],
	"ui_accept": [KEY_ENTER, KEY_KP_ENTER, KEY_SPACE],
	"ui_cancel": [KEY_ESCAPE],
}

## Actions whose buttons clash if they share one: the gameplay verbs, and
## the two menu verbs. (A menu verb sharing a button with a gameplay one —
## B is attack and Menu: back by default — is fine: the menus resolve it
## by priority, use-in-the-list before back.)
const GROUPS := [
	["jump", "attack", "item_x", "item_y", "interact", "dash", "crouch", "aim", "walk", "pause", "map"],
	["menu_accept", "menu_back"],
]

const BUTTON_NAMES := {
	JOY_BUTTON_A: "A", JOY_BUTTON_B: "B", JOY_BUTTON_X: "X", JOY_BUTTON_Y: "Y",
	JOY_BUTTON_BACK: "Back", JOY_BUTTON_GUIDE: "Guide", JOY_BUTTON_START: "Start",
	JOY_BUTTON_LEFT_STICK: "LS", JOY_BUTTON_RIGHT_STICK: "RS",
	JOY_BUTTON_LEFT_SHOULDER: "LB", JOY_BUTTON_RIGHT_SHOULDER: "RB",
	JOY_BUTTON_DPAD_UP: "D-Up", JOY_BUTTON_DPAD_DOWN: "D-Down",
	JOY_BUTTON_DPAD_LEFT: "D-Left", JOY_BUTTON_DPAD_RIGHT: "D-Right",
	JOY_BUTTON_MISC1: "Misc", JOY_BUTTON_PADDLE1: "P1", JOY_BUTTON_PADDLE2: "P2",
	JOY_BUTTON_PADDLE3: "P3", JOY_BUTTON_PADDLE4: "P4", JOY_BUTTON_TOUCHPAD: "Pad",
}
const AXIS_NAMES := {
	JOY_AXIS_TRIGGER_LEFT: "LT", JOY_AXIS_TRIGGER_RIGHT: "RT",
	JOY_AXIS_LEFT_X: "LX", JOY_AXIS_LEFT_Y: "LY", JOY_AXIS_RIGHT_X: "RX", JOY_AXIS_RIGHT_Y: "RY",
}
const MOUSE_NAMES := {
	MOUSE_BUTTON_LEFT: "LMB", MOUSE_BUTTON_RIGHT: "RMB", MOUSE_BUTTON_MIDDLE: "MMB",
	MOUSE_BUTTON_WHEEL_UP: "Wheel↑", MOUSE_BUTTON_WHEEL_DOWN: "Wheel↓",
	MOUSE_BUTTON_XBUTTON1: "Mouse4", MOUSE_BUTTON_XBUTTON2: "Mouse5",
}

## action -> Array[InputEvent], the project.godot defaults, captured once.
var _defaults := {}
## The live override table (same object as SaveManager.settings.bindings
## after apply()).
var _bindings := {}


func _ready() -> void:
	for a in InputMap.get_actions():
		_defaults[String(a)] = InputMap.action_get_events(a).duplicate()
	Input.joy_connection_changed.connect(func(_d: int, _c: bool) -> void: bindings_changed.emit())


# --- applying ---------------------------------------------------------------------------------------

## Rebuild the InputMap from the defaults plus `bindings` (the settings
## dict). SaveManager calls this from apply_settings().
func apply(bindings: Dictionary) -> void:
	_bindings = bindings
	for entry in ACTIONS:
		var action: String = entry[0]
		_set_events(action, _events_for(action))
	for menu: String in MIRRORS:
		var events: Array[InputEvent] = []
		for k in FIXED_KEYS.get(menu, []):
			events.append(_key_event(int(k)))
		events.append_array(_events_for(String(MIRRORS[menu])))
		_set_events(menu, events)
	bindings_changed.emit()


## The events a remappable action should have: per device, the stored
## binding if there is one, else the project default's events of that kind.
func _events_for(action: String) -> Array[InputEvent]:
	var out: Array[InputEvent] = []
	var b: Dictionary = _bindings.get(action, {})
	for device in ["pad", "key"]:
		if b.has(device):
			for d in b[device]:
				var ev := _from_dict(d)
				if ev != null:
					out.append(ev)
		else:
			for ev in _defaults.get(action, []):
				if _device_of(ev) == device:
					out.append(ev)
	# Fixed keys of a remappable menu action (Enter/Space always accept).
	for k in FIXED_KEYS.get(action, []):
		out.append(_key_event(int(k)))
	return out


func _set_events(action: String, events: Array[InputEvent]) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action, 0.5)
	InputMap.action_erase_events(action)
	var seen := {}
	for ev in events:
		var key := _dict_key(ev)
		if seen.has(key):
			continue
		seen[key] = true
		InputMap.action_add_event(action, ev)


# --- editing (the Controls panel) -----------------------------------------------------------------

## Bind `event` as the only `device` ("pad"/"key") control of `action`, save
## and re-apply. Returns false when the event is not bindable (a stick axis,
## the left mouse button, an unknown kind).
func set_binding(action: String, device: String, event: InputEvent) -> bool:
	var d := _to_dict(event)
	if d.is_empty() or _device_of(event) != device:
		return false
	var all: Dictionary = SaveManager.settings.get("bindings", {})
	var b: Dictionary = all.get(action, {})
	b[device] = [d]
	all[action] = b
	SaveManager.set_setting("bindings", all)
	return true


## Forget every override.
func reset_all() -> void:
	SaveManager.set_setting("bindings", {})


func is_default(action: String) -> bool:
	return not _bindings.has(action) or (_bindings[action] as Dictionary).is_empty()


## Other remappable actions in the same clash group bound to the same
## pad control as `action` (for the panel's conflict mark).
func conflicts(action: String, device: String) -> Array[String]:
	var out: Array[String] = []
	var mine := _primary(action, device)
	if mine == "":
		return out
	for group in GROUPS:
		if not group.has(action):
			continue
		for other: String in group:
			if other != action and _primary(other, device) == mine and not out.has(other):
				out.append(other)
	return out


# --- naming -----------------------------------------------------------------------------------------

## True while any joypad is connected: the UI shows pad glyphs then.
func using_pad() -> bool:
	return not Input.get_connected_joypads().is_empty()


## The live control for an action, as a short label. `device` "" picks
## pad while a joypad is connected, keyboard otherwise.
func glyph(action: String, device: String = "") -> String:
	if device == "":
		device = "pad" if using_pad() else "key"
	var g := _primary(action, device)
	return g if g != "" else "—"


## "A select  B use  LB assign" from [[action, verb], …].
func hint(pairs: Array) -> String:
	var parts := PackedStringArray()
	for p in pairs:
		parts.append("%s %s" % [glyph(String(p[0])), String(p[1])])
	return "  ".join(parts)


func display_name(action: String) -> String:
	for entry in ACTIONS:
		if entry[0] == action:
			return entry[1]
	return action


## True while a joypad control bound to `action` is held (regardless of
## what else is bound to it) — used to tell pad aim from mouse aim.
func pad_pressed(action: String) -> bool:
	if not InputMap.has_action(action):
		return false
	var pads := Input.get_connected_joypads()
	if pads.is_empty():
		return false
	for ev in InputMap.action_get_events(action):
		if ev is InputEventJoypadButton:
			for dev in pads:
				if Input.is_joy_button_pressed(dev, ev.button_index):
					return true
		elif ev is InputEventJoypadMotion:
			for dev in pads:
				var v := Input.get_joy_axis(dev, ev.axis)
				if (ev.axis_value > 0.0 and v > 0.5) or (ev.axis_value < 0.0 and v < -0.5):
					return true
	return false


func _primary(action: String, device: String) -> String:
	if not InputMap.has_action(action):
		return ""
	for ev in InputMap.action_get_events(action):
		if _device_of(ev) == device:
			# Skip the fixed menu keys so "Menu: accept" shows its own key.
			if device == "key" and ev is InputEventKey and FIXED_KEYS.has(action) \
					and (FIXED_KEYS[action] as Array).has(ev.physical_keycode) \
					and _bindings.get(action, {}).has("key"):
				continue
			return event_name(ev)
	return ""


static func event_name(ev: InputEvent) -> String:
	if ev is InputEventJoypadButton:
		return String(BUTTON_NAMES.get(ev.button_index, "Btn%d" % ev.button_index))
	if ev is InputEventJoypadMotion:
		var n := String(AXIS_NAMES.get(ev.axis, "Axis%d" % ev.axis))
		if ev.axis <= JOY_AXIS_RIGHT_Y:
			n += "+" if ev.axis_value > 0 else "-"
		return n
	if ev is InputEventKey:
		var code: int = ev.physical_keycode if ev.physical_keycode != KEY_NONE else ev.keycode
		var label: int = code
		if DisplayServer.get_name() != "headless":
			var mapped := DisplayServer.keyboard_get_keycode_from_physical(code)
			if mapped != KEY_NONE:
				label = mapped
		var s := OS.get_keycode_string(label)
		return s if s != "" else "Key%d" % code
	if ev is InputEventMouseButton:
		return String(MOUSE_NAMES.get(ev.button_index, "Mouse%d" % ev.button_index))
	return "?"


# --- event <-> dict ---------------------------------------------------------------------------------

static func _device_of(ev: InputEvent) -> String:
	if ev is InputEventJoypadButton or ev is InputEventJoypadMotion:
		return "pad"
	if ev is InputEventKey or ev is InputEventMouseButton:
		return "key"
	return ""


## Only things that behave like a button are bindable: pad buttons, the
## two triggers, keys, and mouse buttons other than the left one.
static func _to_dict(ev: InputEvent) -> Dictionary:
	if ev is InputEventJoypadButton:
		return {"t": "btn", "i": int(ev.button_index)}
	if ev is InputEventJoypadMotion:
		if ev.axis != JOY_AXIS_TRIGGER_LEFT and ev.axis != JOY_AXIS_TRIGGER_RIGHT:
			return {}
		return {"t": "axis", "a": int(ev.axis), "v": 1.0}
	if ev is InputEventKey:
		var code: int = ev.physical_keycode if ev.physical_keycode != KEY_NONE else ev.keycode
		return {"t": "key", "k": code}
	if ev is InputEventMouseButton:
		if ev.button_index == MOUSE_BUTTON_LEFT:
			return {}
		return {"t": "mouse", "i": int(ev.button_index)}
	return {}


static func _from_dict(d: Variant) -> InputEvent:
	if typeof(d) != TYPE_DICTIONARY:
		return null
	match String(d.get("t", "")):
		"btn":
			var b := InputEventJoypadButton.new()
			b.button_index = int(d.get("i", 0)) as JoyButton
			b.pressed = true
			return b
		"axis":
			var m := InputEventJoypadMotion.new()
			m.axis = int(d.get("a", 4)) as JoyAxis
			m.axis_value = float(d.get("v", 1.0))
			return m
		"key":
			return _key_event(int(d.get("k", 0)))
		"mouse":
			var mb := InputEventMouseButton.new()
			mb.button_index = int(d.get("i", 2)) as MouseButton
			mb.pressed = true
			return mb
	return null


static func _key_event(physical: int) -> InputEventKey:
	var k := InputEventKey.new()
	k.physical_keycode = physical as Key
	return k


static func _dict_key(ev: InputEvent) -> String:
	return JSON.stringify(_to_dict(ev)) if not _to_dict(ev).is_empty() else ev.as_text()
