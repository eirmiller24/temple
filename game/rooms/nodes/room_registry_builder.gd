class_name RoomRegistryBuilder
extends RefCounted
## Builds and validates the room registry from the scenes under
## game/rooms/. Shared by the RoomRegistry autoload (runtime), the
## room_tools editor plugin, and tools/build_room_registry.gd (headless),
## so the three can never disagree about what a valid world grid is.
##
## Record schema: see RoomRegistry.

const ROOMS_DIR := "res://game/rooms"
const REGISTRY_COMMENT := "GENERATED by tools/build_room_registry.gd (or Project > Tools > Rebuild Room Registry) from game/rooms/**.tscn — never edit by hand. World rects are in tiles; entries are feet positions in (fractional) world tiles."


static func scene_paths() -> PackedStringArray:
	var out := PackedStringArray()
	_scan(ROOMS_DIR, out)
	out.sort()
	return out


static func scene_stems() -> PackedStringArray:
	var out := PackedStringArray()
	for p in scene_paths():
		out.append(p.get_file().get_basename())
	return out


static func _scan(dir_path: String, out: PackedStringArray) -> void:
	var d := DirAccess.open(dir_path)
	if d == null:
		return
	d.list_dir_begin()
	var f := d.get_next()
	while f != "":
		if d.current_is_dir():
			if f != "nodes" and not f.begins_with("."):
				_scan(dir_path + "/" + f, out)
		elif f.ends_with(".tscn") or f.ends_with(".tscn.remap"):
			out.append(dir_path + "/" + f.trim_suffix(".remap"))
		f = d.get_next()
	d.list_dir_end()


static func build_from_scenes() -> Dictionary:
	var out := {}
	for path in scene_paths():
		var packed: PackedScene = load(path)
		if packed == null:
			push_error("rooms: cannot load %s" % path)
			continue
		var root := packed.instantiate()
		if not (root is Room):
			push_error("rooms: %s root is not a Room" % path)
			root.free()
			continue
		var room: Room = root
		var stem := path.get_file().get_basename()
		if stem != room.name:
			push_warning("rooms: %s root node is named '%s' — should match the file stem" % [path, room.name])
		out[stem] = describe(room, path)
		root.free()
	return out


## The registry record for one instantiated (not in-tree) room.
static func describe(room: Room, path: String) -> Dictionary:
	var local := room.rect_tiles()
	var wx := room.world_x
	var wy := room.world_y
	var rec := {
		"path": path,
		"display_name": room.room_name(),
		"world_x": wx, "world_y": wy,
		"x": wx + local.position.x, "y": wy + local.position.y,
		"w": local.size.x, "h": local.size.y,
		"skin": room.skin, "background": room.background, "music": room.music,
		"darkness": room.darkness,
		"exits": [], "entries": {},
	}
	var exits := room.get_node_or_null("Exits")
	if exits != null:
		for e in exits.get_children():
			if e is RoomExit:
				var r: Rect2i = e.rect_tiles()
				rec.exits.append({
					"to_room": e.to_room, "to_entry": e.to_entry,
					"x": wx + r.position.x, "y": wy + r.position.y,
					"w": r.size.x, "h": r.size.y,
					"direction": e.direction, "locked_by": e.locked_by,
				})
	var entries := room.get_node_or_null("Entries")
	if entries != null:
		for e in entries.get_children():
			if e is RoomEntry:
				rec.entries[e.id] = {
					"x": wx + e.position.x / Room.TILE,
					"y": wy + e.position.y / Room.TILE,
					"facing": e.facing,
				}
	return rec


## Problems with the current registry, one string each. Empty = valid.
static func validate(reg: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	for name: String in reg:
		var r: Dictionary = reg[name]
		if int(r.world_x) == Room.UNSET or int(r.world_y) == Room.UNSET:
			problems.append("%s: world_x/world_y unset" % name)
			continue
		if int(r.w) <= 0 or int(r.h) <= 0:
			problems.append("%s: Collision layer has no painted cells" % name)
		if (r.entries as Dictionary).is_empty():
			problems.append("%s: no RoomEntry — nothing can spawn the player here" % name)
		for ex: Dictionary in r.exits:
			var to := String(ex.to_room)
			if to == "":
				problems.append("%s: an exit has no to_room" % name)
				continue
			if not reg.has(to):
				problems.append("%s: exit leads to unknown room '%s'" % [name, to])
				continue
			var target: Dictionary = reg[to]
			if String(ex.to_entry) != "":
				if not (target.entries as Dictionary).has(String(ex.to_entry)):
					problems.append("%s: exit → %s names entry '%s', which does not exist" % [name, to, ex.to_entry])
			else:
				# Seam: the exit rect must touch the target room's world rect.
				var er := Rect2i(int(ex.x), int(ex.y), int(ex.w), int(ex.h)).grow(1)
				var tr := Rect2i(int(target.x), int(target.y), int(target.w), int(target.h))
				if not er.intersects(tr):
					problems.append("%s: seam exit → %s does not touch that room on the world grid (exit at %d,%d %dx%d; room at %d,%d %dx%d)"
							% [name, to, ex.x, ex.y, ex.w, ex.h, target.x, target.y, target.w, target.h])
				var back := false
				for bx: Dictionary in target.exits:
					if String(bx.to_room) == name:
						back = true
				if not back:
					problems.append("%s: exit → %s has no exit back (wire both ways, or use a to_entry teleport for a one-way drop)" % [name, to])
	# Overlaps between rooms are legal (secret alcoves) but usually a mistake.
	var names := reg.keys()
	for i in names.size():
		for j in range(i + 1, names.size()):
			var a: Dictionary = reg[names[i]]
			var b: Dictionary = reg[names[j]]
			var ra := Rect2i(int(a.x), int(a.y), int(a.w), int(a.h))
			var rb := Rect2i(int(b.x), int(b.y), int(b.w), int(b.h))
			var inter := ra.intersection(rb)
			if inter.has_area() and inter.size.x > 1 and inter.size.y > 1:
				problems.append("warning: %s and %s overlap on the world grid by %dx%d tiles" % [names[i], names[j], inter.size.x, inter.size.y])
	return problems
