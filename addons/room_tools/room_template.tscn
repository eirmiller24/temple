; The starting point every new room is copied from (Project > Tools >
; New Room...). It lives OUTSIDE game/rooms/ on purpose: the registry
; treats every .tscn under game/rooms/ as a room, and a template there
; would register as an unplaced room and fail the build.
;
; world_x / world_y are deliberately absent: they sit at the UNSET
; sentinel the registry rejects, so a room nobody placed on the grid
; fails loudly instead of landing at the origin. New Room... fills them
; in from the dialog.
[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://game/rooms/nodes/room.gd" id="1_room"]
[ext_resource type="TileSet" path="res://game/rooms/tileset_kind.tres" id="2_kinds"]
[ext_resource type="Script" path="res://game/rooms/nodes/room_entry.gd" id="3_entry"]
[ext_resource type="TileSet" path="res://assets/tilesets/SSW.tres" id="4_art"]

[node name="room_template" type="Node2D"]
script = ExtResource("1_room")

[node name="Collision" type="TileMapLayer" parent="."]
tile_set = ExtResource("2_kinds")

[node name="DecorBack" type="TileMapLayer" parent="."]
z_index = -2
tile_set = ExtResource("4_art")

[node name="DecorFront" type="TileMapLayer" parent="."]
z_index = 2
tile_set = ExtResource("4_art")

[node name="Props" type="Node2D" parent="."]
z_index = 1

[node name="Entries" type="Node2D" parent="."]

[node name="main" type="Marker2D" parent="Entries"]
position = Vector2(80, 352)
script = ExtResource("3_entry")
id = "main"

[node name="Exits" type="Node2D" parent="."]

[node name="Objects" type="Node2D" parent="."]

[node name="Enemies" type="Node2D" parent="."]
